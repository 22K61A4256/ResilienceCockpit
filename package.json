{
  "name": "ResilienceCockpit",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.16.0",
    "@cap-js/hana": "^2.8.1",
    "@sap-cloud-sdk/connectivity": "^4.8.0",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4.8.0",
    "@sap/cds": "^9",
    "@sap/cds-common-content": "^3.2.0",
    "@sap/xssec": "^4",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-hybrid": "cds watch --profile hybrid",
    "watch-supplier-list": "cds watch --open nexus.supplierlist/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy ResilienceCockpit --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-supplier-geo": "cds watch --open nexus.suppliergeo/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "[hybrid]": {
        "db": {
          "kind": "hana"
        }
      },
      "auth": {
        "kind": "basic",
        "users": {
          "alice": {
            "password": "welcome",
            "roles": [
              "NX-SC-USER"
            ]
          },
          "bob": {
            "password": "welcome",
            "roles": [
              "NX-SC-USER",
              "NX-SC-ANL"
            ]
          },
          "charlie": {
            "password": "welcome",
            "roles": [
              "NX-SC-USER",
              "NX-SC-MGR"
            ]
          },
          "david": {
            "password": "welcome",
            "roles": [
              "NX-SC-USER",
              "NX-PR-ANL"
            ]
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "application-logging": true,
      "ShippingCostAPI": {
        "kind": "rest",
        "credentials": {
          "destination": "jsondb"
        }
      },
      "API_INFORECORD_PROCESS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_INFORECORD_PROCESS_SRV",
        "credentials": {
          "destination": "SAP_API_HUB"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/supplier-list"
  ]
}
